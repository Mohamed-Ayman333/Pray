package l10n {

  abstract class AppLocalizations {
    + localeName: String
    + {static} of(context): AppLocalizations
    + {static} delegate: LocalizationsDelegate<AppLocalizations>
    + {static} localizationsDelegates: List<LocalizationsDelegate>
    + {static} supportedLocales: List<Locale>
    + appTitle: String
    + comingNext: String
    + countdown: String
    + dayView: String
    + thirtyDayView: String
    + loadingTodaysPrayers: String
    + columnPrayer / columnTime / columnStatus: String
    + todayLabel: String
    + prayerFajr / prayerSunrise / prayerDhuhr: String
    + prayerAsr / prayerMaghrib / prayerIsha: String
    + prayerDhuha: String
    + prayerHistory / missedPrayersQada / missedPrayers: String
    + markDone: String
    + settingsTitle / preferencesAndCalculation: String
    + calculationAndJurisprudence: String
    + calculationMethod / jurisprudenceSchool: String
    + standardMadhab / hanafiMadhab: String
    + notificationsAndAlerts / notificationsLabel: String
    + notificationsSubtitle: String
    + stickyNotifications / stickyNotificationsSubtitle: String
    + repeatNotificationSound / repeatNotificationSoundSubtitle: String
    + languageLabel / languageEnglish / languageArabic: String
    + valuesAndAdjustments: String
    + optionalPrayerCounterAutoIncrement: String
    + appearanceAndTheme / themeMode: String
    + themeLight / themeDark: String
    + locationPermissionFallbackBanner: String
    + calculationMethodMuslimWorldLeague: String
    + calculationMethodEgyptian: String
    + calculationMethodKarachi: String
    + calculationMethodUmmAlQura: String
    + calculationMethodDubai: String
    + calculationMethodMoonsightingCommittee: String
    + calculationMethodNorthAmerica: String
    + calculationMethodKuwait / Qatar / Singapore: String
    + calculationMethodTehran / Turkey / Other: String
    + prayerTrackingSection / trackPrayers / trackPrayersSubtitle: String
    + batteryPromptTitle / batteryPromptMessage: String
    + batteryPromptLater / batteryPromptAllow: String
    + sunnahBeforeHeader / sunnahAfterHeader: String
    + sunnahDisplaySection: String
    + showSunnahPrayers / showSunnahPrayersSubtitle: String
    + resetCounter / resetCounterDialogTitle: String
    + resetCounterDialogMessage: String
    + resetCounterDialogConfirm / resetCounterDialogCancel: String
    + navPrayers / navCalendar: String
    + notifChannelName / notifChannelDescription: String
    + notifMarkDone: String
    + notifTimeFor(prayer: String): String
    + notifItIsTimeFor(prayer: String): String
  }
  note right of AppLocalizations : generated by flutter gen-l10n

  class AppLocalizationsEn extends AppLocalizations
  class AppLocalizationsAr extends AppLocalizations

  class "_AppLocalizationsDelegate" as L10nDelegate {
    + load(locale): Future<AppLocalizations>
    + isSupported(locale): bool
    + shouldReload(old): bool
  }

  class "lookupAppLocalizations(locale)" as LookupL10n <<top-level function>> {
    + lookupAppLocalizations(locale: Locale): AppLocalizations
  }

  class "AppLocalizationsX" as L10nExt <<extension>> {
    + prayerDisplayName(internalName: String): String
  }

  class "app_en.arb / app_ar.arb" as ArbFiles <<files>>

  AppLocalizations <|-- AppLocalizationsEn
  AppLocalizations <|-- AppLocalizationsAr
  L10nDelegate ..> LookupL10n
  LookupL10n ..> AppLocalizationsEn
  LookupL10n ..> AppLocalizationsAr
  L10nExt -- AppLocalizations
  ArbFiles ..> AppLocalizations
}

' ============================================================
'  core
' ============================================================
package core {

  class AppCore {
    + settingsController: SettingsController
    + daysRepository: DaysRepository
    + AppCore(settingsController, daysRepository)
  }

  class "buildAppCore(isar)" as BuildAppCore <<top-level function>> {
    + buildAppCore(isar: Isar): Future<AppCore>
  }
  note right of BuildAppCore
    Wires:
    SettingsController(SettingsRepository(SettingsStorage(isar)))
    LocalDaysStorage(isar)
    CalculatedDaysStorage(settingsController)
    CachingCalculatedDaysStorage(calculated, local)
    DaysRepository(local, caching, settingsController)
  end note

  BuildAppCore ..> AppCore
}

' ============================================================
'  model
' ============================================================
package model {

  package types {

    class Day {
      + id: Id
      + date: DateTime?
      + prayers: List<Prayer>
      + Day(date, prayers)
      + completedPrayers: List<Prayer>
      + pendingPrayers: List<Prayer>
      + toJson(): Map<String, dynamic>
      + {static} fromJson(json): Day
    }
    note right of Day : Collection, JsonSerializable, unique date

    class Prayer {
      + name: String
      + time: DateTime?
      + isDone: bool
      + Prayer(name, time, isDone)
      + toJson(): Map<String, dynamic>
      + {static} fromJson(json): Prayer
    }
    note right of Prayer : embedded, JsonSerializable

    enum Language {
      ar
      en
    }

    class Settings {
      + id: Id
      + darkMode: bool
      + notifications: bool
      + stickyNotifications: bool
      + repeatNotifications: bool
      + showSunnahPrayers: bool
      + trackPrayers: bool
      + autoIncrementOptionalPrayerCounterBy: int
      + latitude: double
      + longitude: double
      + language: Language
      + calculationMethod: CalculationMethod
      + madhab: Madhab
      + Settings(...)
      + toJson(): Map<String, dynamic>
      + {static} fromJson(json): Settings
    }
    note right of Settings : Collection, JsonSerializable

    class UserState {
      + id: Id
      + optionalPrayerCounter: int
      + hasPromptedBatteryExemption: bool
      + lastAutoIncrementDate: DateTime?
      + UserState(...)
      + toJson(): Map<String, dynamic>
      + {static} fromJson(json): UserState
    }
    note right of UserState : Collection, JsonSerializable

    Day "1" *-- "many" Prayer
    Settings --> Language
  }

  package storage {

    class AppDatabase {
      + {static} init(): Future<Isar>
    }

    interface IDaysStorage {
      + save(day): Future<void>
      + saveAll(days): Future<void>
      + load(date): Future<Day>
      + getInRange(start, end): Future<List<Day>>
    }

    class LocalDaysStorage implements IDaysStorage {
      + isar: Isar
      - _optimizeDay(day): Day
    }

    class CalculatedDaysStorage implements IDaysStorage {
      - _settingsController: SettingsController
      - _calculateDay(date): Day
    }
    note right of CalculatedDaysStorage : read-only generator

    class CachingCalculatedDaysStorage implements IDaysStorage {
      - _calculatedStorage: IDaysStorage
      - _localStorage: IDaysStorage
    }

    class DaysRepository implements IDaysStorage {
      - _localStorage: IDaysStorage
      - _cachingCalculatedStorage: IDaysStorage
      - _settingsController: SettingsController
      + togglePrayer(date, prayerName): Future<void>
      - _toNormalizedUtc(date): DateTime
      - _isPast(date): bool
      - _pastRange(start, end): Future<List<Day>>
      - _fetchTodayRange(today): Future<List<Day>>
      - _fetchFutureRange(start, end): Future<List<Day>>
    }

    interface ISettingsStorage {
      + save(settings): Future<void>
      + load(): Future<Settings>
    }
    class SettingsStorage implements ISettingsStorage {
      + isar: Isar
    }
    class SettingsRepository {
      - _settingsStorage: ISettingsStorage
    }

    interface IUserStateStorage {
      + save(userState): Future<void>
      + load(): Future<UserState>
    }
    class UserStateStorage implements IUserStateStorage {
      + isar: Isar
    }
    class UserStateRepository {
      - _userStateStorage: IUserStateStorage
    }

    AppDatabase ..> Day
    AppDatabase ..> Settings
    AppDatabase ..> UserState

    LocalDaysStorage --> Isar
    SettingsStorage --> Isar
    UserStateStorage --> Isar

    CalculatedDaysStorage --> SettingsController
    CachingCalculatedDaysStorage --> "2" IDaysStorage
    DaysRepository --> "2" IDaysStorage
    DaysRepository --> SettingsController
    SettingsRepository --> ISettingsStorage
    UserStateRepository --> IUserStateStorage
  }
}

' ============================================================
'  controller
' ============================================================
package controller {

  class SettingsController {
    - _settingsRepository: SettingsRepository
    - _currentSettings: Settings
    - _isInitialized: bool
    + isInitialized: bool
    + currentSettings: Settings
    + isDarkMode: bool
    + calculationMethod: CalculationMethod
    + madhab: Madhab
    + language: Language
    + notifications: bool
    + stickyNotifications: bool
    + repeatNotifications: bool
    + autoIncrementOptionalPrayerCounterBy: int
    + showSunnahPrayers: bool
    + trackPrayers: bool
    + init(): Future<void>
    - _updateAndSave(update)
    + updateLocation(lat, lon)
    + setDarkMode(enabled)
    + toggleNotifications(enabled)
    + toggleStickyNotifications(enabled)
    + toggleRepeatNotifications(enabled)
    + setTrackPrayers(enabled)
    + updateAutoIncrementOptionalPrayerCounterBy(value)
    + incrementAutoIncrementValue()
    + decrementAutoIncrementValue()
    + updateLanguage(language)
    + updateCalculationMethod(method)
    + updateMadhab(madhab)
    + toggleShowSunnahPrayers(enabled)
  }
  note right of SettingsController : extends ChangeNotifier

  class UserStateController {
    - _userStateRepository: UserStateRepository
    - _currentUserState: UserState
    - _isInitialized: bool
    + isInitialized: bool
    + currentUserState: UserState
    + init(): Future<void>
    - _updateAndSave(update)
    + incrementOptionalPrayer(step)
    + decrementOptionalPrayer(step)
    + setOptionalPrayerCounter(value)
    + markBatteryExemptionPrompted()
    + applyDailyAutoIncrement(incrementBy)
    - _isSameUtcDay(a, b): bool
  }
  note right of UserStateController : extends ChangeNotifier

  class DaysController {
    - _daysRepository: DaysRepository
    - _settingsController: SettingsController
    - _loadedDays: Map<DateTime, Day>
    + dispose(): void
    - _onSettingsChanged(): Future<void>
    + syncNotifications(): Future<void>
    + clearAndReload(): Future<void>
    + loadedDays: Map<DateTime, Day>
    - _normalizeDate(date): DateTime
    + loadDay(date): Future<void>
    + loadDaysInRange(start, end): Future<void>
    + loadMonth(monthDate): Future<void>
    + getDay(date): Day
    + getOrLoadDay(date): Future<Day>
    + getMissedPrayersCount(date): int
    + isDayFullyCompleted(date): bool
    + togglePrayer(date, prayerName): Future<void>
    + nextPrayer: Prayer
    + timeUntilNextPrayer: Duration
    + loadNext30Days(): Future<void>
  }
  note right of DaysController : extends ChangeNotifier, listens to SettingsController

  SettingsController --> SettingsRepository
  SettingsController o-- Settings
  UserStateController --> UserStateRepository
  UserStateController o-- UserState
  DaysController --> DaysRepository
  DaysController --> SettingsController
  DaysController o-- "*" Day
}

