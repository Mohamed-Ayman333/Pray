@startuml class_diagram

package model {

    package type {

        class Day {
            +date: DateTime
            +prayers: List<Prayer>

            + <<get>> completedPrayers: List<Prayer>
            + <<get>> pendingPrayers: List<Prayer>
            +toJson(): Map<String, dynamic>
            +Day.fromJson(json: Map<String, dynamic>): Day
        }

        class Prayer {
            +name: String
            +time: DateTime
            +isDone: bool

            +toJson(): Map<String, dynamic>
            +Prayer.fromJson(json: Map<String, dynamic>): Prayer
        }

        enum Language {
            EN
            AR
        }

        class Settings {
            + id: Id = 1
            + darkMode: Boolean = true
            + notifications: Boolean = false
            + stickyNotifications: Boolean = false
            + azan: Boolean = false
            + reminderOffsetInMinutes: Integer = 0
            + autoIncrementOptionalPrayerCounterBy: Integer = 0
            + language: Language = Language.en
            + calculationMethod: CalculationMethod = CalculationMethod.egyptian
            + madhab: Madhab = Madhab.shafi

            + Settings(...)
            + Settings.fromJson(json: Map<String, dynamic>): Settings
            + toJson(): Map<String, dynamic>
        }

        class UserState {
            +optionalPrayerCounter: int

            +toJson(): Map<String, dynamic>
            +UserState.fromJson(json: Map<String, dynamic>): UserState
            +copyWith(optionalPrayerCounter: int?): UserState
        }

        Day "1" *-- "many" Prayer
    }

    package storage {

        class appDatabase{
            init(): Future<isar>
        }

        interface IDaysStorage {
            +save(day: Day): Future<void>
            +load(date: DateTime): Future<Day?>
            +getInRange(startDate: DateTime, endDate: DateTime): Future<List<Day>>
            +saveAll(days: List<Day>): Future<void>
        }

        class LocalDaysStorage implements IDaysStorage {
            +save(day: Day): Future<void>
            +load(date: DateTime): Future<Day?>
            +getInRange(startDate: DateTime, endDate: DateTime): Future<List<Day>>
            +saveAll(days: List<Day>): Future<void>
        }

        class CalculatedDaysStorage implements IDaysStorage {
            +save(day: Day): Future<void>
            +load(date: DateTime): Future<Day?>
            +getInRange(startDate: DateTime, endDate: DateTime): Future<List<Day>>
            +saveAll(days: List<Day>): Future<void>
        }

        class CachingCalculatedDaysStorage implements IDaysStorage {
            -localStorage: IDaysStorage
            -calculatedStorage: IDaysStorage

            +save(day: Day): Future<void>
            +load(date: DateTime): Future<Day?>
            +getInRange(startDate: DateTime, endDate: DateTime): Future<List<Day>>
            +saveAll(days: List<Day>): Future<void>
        }

        class DaysRepository implements IDaysStorage {
            -localStorage: IDaysStorage
            -cachingCalculatedStorage: IDaysStorage

            +save(day: Day): Future<void>
            +load(date: DateTime): Future<Day?>
            +getInRange(startDate: DateTime, endDate: DateTime): Future<List<Day>>
            +saveAll(days: List<Day>): Future<void>
            - _isPastOrToday(date: DateTime) : Boolean
        }

        interface ISettingsStorage {
            +save(settings: Settings): Future<void>
            +load(): Future<Settings?>
        }

        class SettingsStorage implements ISettingsStorage {
            +save(settings: Settings): Future<void>
            +load(): Future<Settings?>
        }

        class SettingsRepository {
            -settingsStorage: ISettingsStorage

            +save(settings: Settings): Future<void>
            +load(): Future<Settings?>
        }

        interface IUserStateStorage {
            +save(userState: UserState): Future<void>
            +load(): Future<UserState?>
        }

        class UserStateStorage implements IUserStateStorage {
            +save(userState: UserState): Future<void>
            +load(): Future<UserState?>
        }

        class UserStateRepository {
            -userStateStorage: IUserStateStorage

            +save(userState: UserState): Future<void>
            +load(): Future<UserState?>
        }

        DaysRepository --> "2" IDaysStorage
        SettingsRepository --> ISettingsStorage
        UserStateRepository --> IUserStateStorage

    }

}

package controller {

    class SettingsController {
        - _settingsRepository: SettingsRepository
        - _currentSettings: Settings
        - _isInitialized: Boolean = false

        + SettingsController(settingsRepository: SettingsRepository)
        + get isInitialized(): Boolean
        + get currentSettings(): Settings
        + init(): Future<void>
        + toggleDarkMode(enabled: Boolean): Future<void>
        + toggleNotifications(enabled: Boolean): Future<void>
        + toggleStickyNotifications(enabled: Boolean): Future<void>
        + toggleAzan(enabled: Boolean): Future<void>
        + updateReminderOffset(minutes: Integer): Future<void>
        + updateAutoIncrementOptionalPrayerCounterBy(value: Integer): Future<void>
        + updateLanguage(language: Language): Future<void>
        + updateCalculationMethod(method: CalculationMethod): Future<void>
        + updateMadhab(madhab: Madhab): Future<void>
        - _updateAndSave(update: Function): Future<void>
    }

    class UserStateController {
        -userStateRepository: UserStateRepository
        -currentUserState: UserState

        +getUserState(): UserState
        +incrementOptionalPrayer(): void
        +decrementOptionalPrayer(): void
    }

    class DaysController {
        - _daysRepository: IDaysStorage
        - _loadedDays: Map<DateTime, Day>

        + DaysController(daysRepository: IDaysStorage)
        + loadDay(date: DateTime): Future<void>
        + loadDaysInRange(startDate: DateTime, endDate: DateTime): Future<void>
        + getDay(date: DateTime): Day?
        + togglePrayer(date: DateTime, prayerName: String): Future<void>
        - _normalizeDate(date: DateTime): DateTime
    }

    DaysController "1" --> "1" IDaysStorage : uses
    DaysController "1" o-- "*" Day : manages in cache
    SettingsController "1" --> "1" SettingsRepository : delegates persistence to
    SettingsController "1" o-- "1" Settings : holds state
    UserStateController --> UserStateRepository
    UserStateController --> UserState
    
}

package view {

    class MainApp {
        -settingsController: SettingsController
        +build(): Widget
    }

    class HomePage {
        -daysController: DaysController
        -userStateController: UserStateController
        build(): Widget
    }

    class SettingsPage {
        -settingsController: SettingsController
        build(): Widget
    }

    class CalendarPage {
        -daysController: DaysController
        build(): Widget
    }

    MainApp --> SettingsController
    HomePage ..> DaysController : <<uses>>
    HomePage ..> UserStateController : <<uses>>
    SettingsPage ..> SettingsController : <<uses>>
    CalendarPage ..> DaysController : <<uses>>

}

@enduml