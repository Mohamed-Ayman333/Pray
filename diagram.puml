' ============================================================
'  APP ENTRY  (main.dart)
' ============================================================
package "app entry (main.dart)" as entry {

  class "main()" as Main <<top-level function>> {
    + main(): Future<void>
  }
  note right of Main
    Bootstrap order:
    AppDatabase.init
    -> buildAppCore(isar)
    -> UserStateController.init
    -> applyDailyAutoIncrement
    -> NotificationService.instance.init
    -> loadMonth + loadNext30Days
    -> runApp(MultiProvider[Settings,UserState,Days])
    -> Workmanager.initialize + registerStickyNotificationWorker
  end note

  class "handleNotificationResponse(response)" as HandleNotif <<local closure>> {
    + handleNotificationResponse(response): Future<void>
  }
  note right of HandleNotif : only acts on 'mark_done_action'

  class "_refreshLocationInBackground(settings)" as RefreshLoc <<top-level function>> {
    + _refreshLocationInBackground(settings: SettingsController): Future<void>
  }
  note right of RefreshLoc : Geolocator; threshold 0.001 to skip writes

  class MyApp {
    + MyApp(key: Key?)
    + createState(): State<MyApp>
  }

  class _MyAppState {
    - _midnightTimer: Timer?
    + initState / dispose
    + didChangeAppLifecycleState(state)
    - _scheduleMidnightCheck()
    - _runAutoIncrement()
    - _reloadAll()
    - _refreshLocationOnResume()
    + build(context): Widget
  }
  note right of _MyAppState : with WidgetsBindingObserver

  MyApp *-- _MyAppState
  Main ..> HandleNotif
  Main ..> RefreshLoc
  Main ..> MyApp
}

