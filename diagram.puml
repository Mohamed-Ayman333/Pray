@startuml class_diagram

package model {

    package type {

        class Day {
            +date: DateTime
            +prayers: List<Prayer>

            + <<get>> completedPrayers: List<Prayer>
            + <<get>> pendingPrayers: List<Prayer>
            +toJson(): Map<String, dynamic>
            +Day.fromJson(json: Map<String, dynamic>): Day
            +copyWith(date: DateTime?, prayers: List<Prayer>?): Day
        }

        class Prayer {
            +name: String
            +time: DateTime
            +isDone: bool

            +toJson(): Map<String, dynamic>
            +Prayer.fromJson(json: Map<String, dynamic>): Prayer
            +copyWith(name: String?, time: DateTime?, isDone: bool?): Prayer
        }

        enum Language {
            EN
            AR
        }

        class Settings {
            +darkMode: bool
            +notifications: bool
            +reminderOffsetInMinutes: int
            +stickyNotifications: bool
            +autoIncrementOptionalPrayerCounterBy: int
            +azan: bool
            +language: Language

            +toJson(): Map<String, dynamic>
            +Settings.fromJson(json: Map<String, dynamic>): Settings
            +copyWith(darkMode: bool?, notifications: bool?, reminderOffsetinMinutes: int?, stickyNotifications: bool?, autoIncrementOptionalPrayerCounterBy: int?, azan: bool?, language: Language?): Settings
        }

        class UserState {
            +optionalPrayerCounter: int

            +toJson(): Map<String, dynamic>
            +UserState.fromJson(json: Map<String, dynamic>): UserState
            +copyWith(optionalPrayerCounter: int?): UserState
        }

        Day "1" *-- "many" Prayer
    }

    package storage {

    interface IDaysStorage {
        +save(day: Day): Future<void>
        +load(date: DateTime): Future<Day?>
        +getInRange(startDate: DateTime, endDate: DateTime): Future<List<Day>>
    }

    class LocalDaysStorage implements IDaysStorage {
        +save(day: Day): Future<void>
        +load(date: DateTime): Future<Day?>
        +getInRange(startDate: DateTime, endDate: DateTime): Future<List<Day>>
    }

    class OnlineDaysStorage implements IDaysStorage {
        +save(day: Day): Future<void>
        +load(date: DateTime): Future<Day?>
        +getInRange(startDate: DateTime, endDate: DateTime): Future<List<Day>>
    }

    class DaysRepository implements IDaysStorage {
        -localStorage: IDaysStorage
        -onlineStorage: IDaysStorage

        +save(day: Day): Future<void>
        +load(date: DateTime): Future<Day?>
        +getInRange(startDate: DateTime, endDate: DateTime): Future<List<Day>>
    }

    interface ISettingsStorage {
        +save(settings: Settings): Future<void>
        +load(): Future<Settings?>
    }

    class SettingsStorage implements ISettingsStorage {
        +save(settings: Settings): Future<void>
        +load(): Future<Settings?>
    }

    class SettingsRepository {
        -settingsStorage: ISettingsStorage

        +save(settings: Settings): Future<void>
        +load(): Future<Settings?>
    }

    interface IUserStateStorage {
        +save(userState: UserState): Future<void>
        +load(): Future<UserState?>
    }

    class UserStateStorage implements IUserStateStorage {
        +save(userState: UserState): Future<void>
        +load(): Future<UserState?>
    }

    class UserStateRepository {
        -userStateStorage: IUserStateStorage

        +save(userState: UserState): Future<void>
        +load(): Future<UserState?>
    }

    DaysRepository --> "2" IDaysStorage
    SettingsRepository --> ISettingsStorage
    UserStateRepository --> IUserStateStorage

}

}

package controller {

    class SettingsController {
        -settingsRepository: SettingsRepository
        -currentSettings: Settings

        +getSettings(): Settings
        +toggleDarkMode(enabled: bool): void
        +toggleNotifications(enabled: bool): void
        +updateReminderOffset(minutes: int): void
        +toggleStickyNotifications(enabled: bool): void
        +updateAutoIncrementOptionalPrayerCounterBy(value: int): void
    }

    class UserStateController {
        -userStateRepository: UserStateRepository
        -currentUserState: UserState

        +getUserState(): UserState
        +incrementOptionalPrayer(): void
        +decrementOptionalPrayer(): void
    }

    class DaysController {
        -daysRepository: DaysRepository
        -loadedDays: Map<DateTime, Day>

        +loadDay(date: DateTime): void
        +loadDaysInRange(startDate: DateTime, endDate: DateTime): void
        +getDay(date: DateTime): Day?
        +togglePrayer(date: DateTime, prayerName: String): void
    }

    SettingsController --> SettingsRepository
    SettingsController --> Settings
    UserStateController --> UserStateRepository
    UserStateController --> UserState
    DaysController --> DaysRepository
    DaysController --> "many" Day
    
}

package view {

    class MainApp {
        -settingsController: SettingsController
        +build(): Widget
    }

    class HomePage {
        -daysController: DaysController
        -userStateController: UserStateController
        build(): Widget
    }

    class SettingsPage {
        -settingsController: SettingsController
        build(): Widget
    }

    class CalendarPage {
        -daysController: DaysController
        build(): Widget
    }

    MainApp --> SettingsController
    HomePage ..> DaysController : <<uses>>
    HomePage ..> UserStateController : <<uses>>
    SettingsPage ..> SettingsController : <<uses>>
    CalendarPage ..> DaysController : <<uses>>

}

@enduml